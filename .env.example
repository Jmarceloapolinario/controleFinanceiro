# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# O .env está no .gitignore. Nunca faça commit dele.

# --- PostgreSQL ---
DB_HOST=localhost
# Mantenha 5432: o docker-compose publica "${DB_PORT}:5432" para o host, mas o container sempre escuta na porta 5432.
# então qualquer outro valor quebra o mapeamento da porta do container.
DB_PORT=5432
DB_NAME=controle_financeiro
DB_USERNAME=postgres
DB_PASSWORD=troque_esta_senha

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JPA / Flyway (opcionais) ---
DB_DDL_AUTO=validate
DB_SHOW_SQL=false
DB_FORMAT_SQL=false
FLYWAY_ENABLED=true

# --- JWT (opcional) ---
# Por padrão a aplicação lê src/main/resources/authz.pub e authz.pem.
# Descomente para apontar para outro local:
# JWT_PUBLIC_KEY=file:/caminho/para/authz.pub
# JWT_PRIVATE_KEY=file:/caminho/para/authz.pem
